# Public runtime config
# These values are safe to expose through Nuxt public runtime config.
# In production they can live in normal env files or deploy-time public env.
# Production app server processes should set NODE_ENV=production in the host unit/container environment.
NUXT_PUBLIC_APP_URL="http://localhost:3000"
NUXT_PUBLIC_SUPPORT_EMAIL="support@cofoundry.dev"
NUXT_PUBLIC_BACKEND_MODE="mock"
NUXT_PUBLIC_BILLING_MODE="mock"
# Set this only for local review or deliberate staging demos.
# Leave it false for production-facing deployments that should behave like a marketing shell until real auth is live.
NUXT_PUBLIC_ENABLE_DEMO_ACCESS="false"
NUXT_PUBLIC_FEATURE_INVESTMENT_MODULE="false"
NUXT_PUBLIC_SUPABASE_URL=""
NUXT_PUBLIC_SUPABASE_ANON_KEY=""
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
NUXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=""
NUXT_PUBLIC_STRIPE_PRICE_TEAM_MONTHLY=""

# Server-only secrets
# Leave these blank for local mock mode.
# In future production secret-backed mode, inject these from Vault-managed env files on the server.
SESSION_SIGNING_SECRET=""
# Required only for non-interactive server workers that call /api/operations/*.
# Generate a long random value and inject it from Vault-managed server env.
COFOUNDRY_OPERATIONS_TOKEN=""
# Optional local durable store for mock/access-request operations telemetry.
# Defaults to .data/*.json relative to the repo/app cwd.
# This also stores mock-mode member workspace state, collaboration state, access requests, admin audit overlays, privacy/trust review requests, local file artifacts, and invited local accounts until Supabase mode is enabled.
COFOUNDRY_LOCAL_DATA_DIR=""
COFOUNDRY_OPERATIONS_RETENTION_LIMIT="200"
COFOUNDRY_OPERATIONS_TIMEOUT_MS="60000"
COFOUNDRY_ACCESS_REQUEST_RETENTION_LIMIT="500"
COFOUNDRY_ADMIN_AUDIT_RETENTION_LIMIT="500"
COFOUNDRY_COLLABORATION_RETENTION_LIMIT="1000"
COFOUNDRY_PRIVACY_REQUEST_RETENTION_LIMIT="500"
SUPABASE_SERVICE_ROLE_KEY=""
# Optional one-time first-admin bootstrap inputs for:
#   BOOTSTRAP_ADMIN_EMAIL="operator@example.com" npm run -w back-end bootstrap-admin
# The user must already exist through the normal auth/account path.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_USER_ID=""
BOOTSTRAP_ADMIN_ROLE="admin"
BOOTSTRAP_ADMIN_NOTES=""
STRIPE_SECRET_KEY=""
# Required when NUXT_PUBLIC_BILLING_MODE="stripe"; register /api/billing/webhook in Stripe.
STRIPE_WEBHOOK_SECRET=""

# Contact form mail delivery
# Preferred production path: SMTP, which gives strict control over the envelope sender.
# Current default behavior should send submissions directly to contacts@jacobdanderson.net.
# To switch later to an alias/outbound-recipient pattern, set CONTACT_FROM_EMAIL to the alias,
# CONTACT_TO_EMAIL to the primary recipient, and CONTACT_BCC_EMAIL to contacts@jacobdanderson.net.
CONTACT_FROM_EMAIL=""
CONTACT_FROM_NAME="CoFoundry"
CONTACT_TO_EMAIL="contacts@jacobdanderson.net"
CONTACT_BCC_EMAIL=""
CONTACT_USE_SENDMAIL="false"
CONTACT_SENDMAIL_PATH=""
CONTACT_SMTP_HOST=""
CONTACT_SMTP_PORT=""
CONTACT_SMTP_SECURE="false"
CONTACT_SMTP_REQUIRE_TLS="false"
CONTACT_SMTP_USER=""
CONTACT_SMTP_PASS=""

# File storage and scanning
# No extra public env is required. In Supabase mode, uploads use the private
# cofoundry-private-files bucket created by migrations. Scanner workers should
# update file scan results through server-side admin credentials only.
COFOUNDRY_FILE_SCANNER_COMMAND=""
COFOUNDRY_BACKUP_PROVIDER="server-backup"
COFOUNDRY_BACKUP_ARTIFACT_URI=""

# Optional provider readiness markers.
# Leave these blank until the provider is selected.
# Suppression, contract, and trust markers expect recent provider evidence rows once set.
# OAuth markers are cutover markers only; keep them blank until live callback/account-linking support is deployed.
COFOUNDRY_EMAIL_SUPPRESSION_PROVIDER=""
COFOUNDRY_OAUTH_PROVIDER=""
COFOUNDRY_GOOGLE_OAUTH_PROVIDER=""
COFOUNDRY_GITHUB_OAUTH_PROVIDER=""
COFOUNDRY_CONTRACT_ENVELOPE_PROVIDER=""
COFOUNDRY_TRUST_VERIFICATION_PROVIDER=""
COFOUNDRY_IDENTITY_VERIFICATION_PROVIDER=""
COFOUNDRY_DOMAIN_VERIFICATION_PROVIDER=""
COFOUNDRY_SOCIAL_VERIFICATION_PROVIDER=""

# Seed behavior
# Keep this true if you want the seed script to create demo auth users when Supabase mode is enabled.
SEED_SUPABASE_AUTH="true"

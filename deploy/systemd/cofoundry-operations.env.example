# Copy to /etc/cofoundry/operations.env and replace placeholders.
# Values in the real file should come from Vault-managed or host-managed env.

NUXT_PUBLIC_APP_URL=https://cofoundry.example.com
# Set this in Supabase mode so the file scanner accepts only signed downloads
# from the configured storage origin. Add custom storage origins explicitly.
# NUXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
# COFOUNDRY_FILE_DOWNLOAD_ORIGINS=https://storage.example.com
COFOUNDRY_RELEASE=v1.x
COFOUNDRY_COMMIT_SHA=replace-with-deployed-git-sha
COFOUNDRY_DEPLOYED_AT=2026-06-14T00:00:00Z
COFOUNDRY_OPERATIONS_TOKEN=replace-with-long-random-worker-token
COFOUNDRY_OPERATIONS_TIMEOUT_MS=60000

# Optional worker-side alert webhook. Leave unset until the destination is chosen.
# COFOUNDRY_ALERT_WEBHOOK_URL=https://alerts.example.com/cofoundry
# COFOUNDRY_ALERT_WEBHOOK_TOKEN=replace-with-alert-webhook-token
COFOUNDRY_ALERT_SEVERITIES=error,warning
COFOUNDRY_ALERT_TIMEOUT_MS=10000

# Digest worker.
COFOUNDRY_DIGEST_MAX_USERS=100
# Leave the digest service in dry-run mode until SMTP and pilot preferences are verified.
COFOUNDRY_DIGEST_DRY_RUN=true

# Mail smoke test. Use a monitored inbox controlled by operations.
COFOUNDRY_MAIL_SMOKE_TO_EMAIL=contacts@jacobdanderson.net

# Realtime fanout smoke test. Keep min delivered at 0 for ingress-only smoke.
# Set to 1+ only when a member SSE stream is intentionally connected to another instance.
COFOUNDRY_REALTIME_SMOKE_USER_ID=cofoundry-realtime-smoke-user
COFOUNDRY_REALTIME_SMOKE_MIN_DELIVERED=0

# Backup worker. Prefer host-owned wrapper scripts for provider-specific logic.
COFOUNDRY_BACKUP_PROVIDER=server-backup
COFOUNDRY_BACKUP_ARTIFACT_URI=file:///var/backups/cofoundry/latest.dump
COFOUNDRY_BACKUP_COMMAND=/etc/cofoundry/run-backup.sh

# File scanner worker. Example: clamscan --no-summary {file}
COFOUNDRY_FILE_SCANNER_COMMAND=
COFOUNDRY_SCAN_LIMIT=25

# Restore drill worker. Enable the timer only after this script is real.
COFOUNDRY_RESTORE_DRILL_COMMAND=/etc/cofoundry/verify-restore.sh

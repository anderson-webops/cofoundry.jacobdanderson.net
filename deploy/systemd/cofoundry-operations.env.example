# Copy to /etc/cofoundry/operations.env and replace placeholders.
# Values in the real file should come from Vault-managed or host-managed env.

NUXT_PUBLIC_APP_URL=https://cofoundry.example.com
COFOUNDRY_OPERATIONS_TOKEN=replace-with-long-random-worker-token
COFOUNDRY_OPERATIONS_TIMEOUT_MS=60000

# Digest worker.
COFOUNDRY_DIGEST_MAX_USERS=100
# Leave the digest service in dry-run mode until SMTP and pilot preferences are verified.
COFOUNDRY_DIGEST_DRY_RUN=true

# Backup worker. Prefer host-owned wrapper scripts for provider-specific logic.
COFOUNDRY_BACKUP_PROVIDER=server-backup
COFOUNDRY_BACKUP_ARTIFACT_URI=file:///var/backups/cofoundry/latest.dump
COFOUNDRY_BACKUP_COMMAND=/etc/cofoundry/run-backup.sh

# File scanner worker. Example: clamscan --no-summary {file}
COFOUNDRY_FILE_SCANNER_COMMAND=
COFOUNDRY_SCAN_LIMIT=25

# Restore drill worker. Enable the timer only after this script is real.
COFOUNDRY_RESTORE_DRILL_COMMAND=/etc/cofoundry/verify-restore.sh

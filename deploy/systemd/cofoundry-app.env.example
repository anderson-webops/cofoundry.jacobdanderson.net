# Copy to /etc/cofoundry/app.env with mode 0600 and inject real host values.
# Blank secret and deployment-identity values are intentional fail-closed defaults.

NUXT_PUBLIC_APP_URL=https://cofoundry.jacobdanderson.net
NUXT_PUBLIC_BACKEND_MODE=mock
NUXT_PUBLIC_BILLING_MODE=mock
NUXT_PUBLIC_ENABLE_DEMO_ACCESS=false

COFOUNDRY_RELEASE=
COFOUNDRY_COMMIT_SHA=
COFOUNDRY_DEPLOYED_AT=
COFOUNDRY_LOCAL_DATA_DIR=/var/lib/cofoundry
COFOUNDRY_OPERATIONS_TOKEN=
SESSION_SIGNING_SECRET=

COFOUNDRY_EXPECT_MULTI_INSTANCE=false
COFOUNDRY_APP_INSTANCE_COUNT=1

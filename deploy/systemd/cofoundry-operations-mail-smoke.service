[Unit]
Description=CoFoundry mail delivery smoke test
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=cofoundry
Group=cofoundry
WorkingDirectory=/srv/cofoundry/current
EnvironmentFile=/etc/cofoundry/operations.env
ExecStart=/usr/bin/env bash -lc 'npm run operations:mail-smoke -- --to-email "$${COFOUNDRY_MAIL_SMOKE_TO_EMAIL}" --metadata runbook=systemd-manual'
SyslogIdentifier=cofoundry-operations-mail-smoke
NoNewPrivileges=true
PrivateTmp=true

[Unit]
Description=CoFoundry file scan worker
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=cofoundry
Group=cofoundry
WorkingDirectory=/srv/cofoundry/current
EnvironmentFile=/etc/cofoundry/operations.env
Environment=PATH=/opt/node-26.13.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
Environment=NODE_OPTIONS=--max-old-space-size=192
ExecStart=/opt/node-26.13.0/bin/node back-end/dist/operations-worker.js scan
SyslogIdentifier=cofoundry-operations-scan
AmbientCapabilities=
CapabilityBoundingSet=
LockPersonality=true
MemoryHigh=320M
MemoryMax=384M
NoNewPrivileges=true
PrivateDevices=true
PrivateMounts=true
PrivateTmp=true
ProcSubset=pid
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ReadWritePaths=/var/lib/cofoundry /run/cofoundry
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RuntimeDirectory=cofoundry
StateDirectory=cofoundry
SystemCallArchitectures=native
TasksMax=64
TimeoutStartSec=1h
TimeoutStopSec=30s
UMask=0077

[Unit]
Description=CoFoundry operations heartbeat event
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=cofoundry
Group=cofoundry
WorkingDirectory=/srv/cofoundry/current
EnvironmentFile=/etc/cofoundry/operations.env
ExecStart=/usr/bin/env bash -lc 'npm run operations:heartbeat -- --metadata schedule=hourly --metadata timer=cofoundry-operations-heartbeat'
SyslogIdentifier=cofoundry-operations-heartbeat
NoNewPrivileges=true
PrivateTmp=true

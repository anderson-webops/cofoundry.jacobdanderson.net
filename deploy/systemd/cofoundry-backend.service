[Unit]
Description=CoFoundry operational API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=cofoundry
Group=cofoundry
WorkingDirectory=/srv/cofoundry/current
EnvironmentFile=/etc/cofoundry/app.env
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=192
Environment=BACKEND_HOST=127.0.0.1
Environment=BACKEND_PORT=3015
ExecStartPre=/usr/bin/test -f /srv/cofoundry/current/back-end/dist/server.js
ExecStart=/opt/node-24.18.1/bin/node back-end/dist/server.js
Restart=on-failure
RestartSec=5s
SyslogIdentifier=cofoundry-backend
AmbientCapabilities=
CapabilityBoundingSet=
LockPersonality=true
MemoryHigh=320M
MemoryMax=384M
NoNewPrivileges=true
PrivateDevices=true
PrivateMounts=true
PrivateTmp=true
ProcSubset=pid
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ReadWritePaths=/var/lib/cofoundry /run/cofoundry
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RuntimeDirectory=cofoundry
StateDirectory=cofoundry
SystemCallArchitectures=native
TasksMax=64
TimeoutStartSec=30s
TimeoutStopSec=30s
UMask=0077

[Install]
WantedBy=multi-user.target

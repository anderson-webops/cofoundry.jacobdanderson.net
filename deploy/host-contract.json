{
  "schema_version": 1,
  "site": "cofoundry.jacobdanderson.net",
  "adapter": {
    "id": "cofoundry-native",
    "minimum_version": 1
  },
  "runtime": {
    "node": "24.18.1",
    "npm": "12.0.2",
    "architecture": "arm64"
  },
  "artifact_format": "signed-native-tar-v1",
  "requires": [
    "artifact:mac-signed",
    "rollback:retained-artifact",
    "acceptance:origin-dual-stack"
  ],
  "database": {
    "change": "review-required"
  },
  "rollback": {
    "strategy": "retained-artifact",
    "database_compatible": false
  }
}

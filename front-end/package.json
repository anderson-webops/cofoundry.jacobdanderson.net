{
  "name": "front-end",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Nuxt frontend for CoFoundry",
  "author": "Jacob Anderson",
  "license": "ISC",
  "keywords": [],
  "scripts": {
    "build": "nuxt build --dotenv ../.env",
    "dev": "nuxt dev --dotenv ../.env --port 3000",
    "generate": "nuxt generate --dotenv ../.env",
    "prepare": "nuxt prepare --dotenv ../.env",
    "preview": "nuxt preview --dotenv ../.env",
    "preview:e2e": "nuxt preview --host=127.0.0.1 --port=4173",
    "serve": "nuxt dev --dotenv ../.env --open --host 0.0.0.0 --port 3000",
    "start": "node .output/server/index.mjs",
    "start:generate": "npx serve .output/public",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "test": "vitest",
    "test:e2e": "playwright install chromium && npm run build && playwright test",
    "test:run": "vitest run",
    "test:unit": "vitest run",
    "typecheck": "nuxt typecheck --dotenv ../.env"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.103.3",
    "stripe": "22.0.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@iconify-json/carbon": "1.2.20",
    "@iconify-json/twemoji": "1.2.5",
    "@nuxt/devtools": "3.2.4",
    "@nuxt/eslint": "1.15.2",
    "@nuxtjs/color-mode": "4.0.0",
    "@pinia/nuxt": "0.11.3",
    "@playwright/test": "1.59.1",
    "@types/node": "25.6.0",
    "@unocss/nuxt": "66.6.8",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "2.4.8",
    "@vueuse/core": "14.2.1",
    "@vueuse/nuxt": "14.2.1",
    "happy-dom": "^20.9.0",
    "nuxt": "4.4.2",
    "pinia": "3.0.4",
    "tsx": "4.21.0",
    "typescript": "^6.0.3",
    "unocss": "66.6.8",
    "vitest": "4.1.5",
    "vue": "3.5.33",
    "vue-tsc": "3.2.7"
  }
}

{
  "name": "front-end",
  "type": "module",
  "version": "1.3.4",
  "private": true,
  "description": "Nuxt frontend for CoFoundry",
  "author": "Jacob Anderson",
  "license": "ISC",
  "keywords": [],
  "scripts": {
    "build": "nuxt build --dotenv ../.env",
    "dev": "nuxt dev --dotenv ../.env --port 3000",
    "generate": "nuxt generate --dotenv ../.env",
    "prepare": "nuxt prepare",
    "preview": "nuxt preview --dotenv ../.env",
    "preview:e2e": "nuxt preview --host=127.0.0.1 --port=4173",
    "serve": "nuxt dev --dotenv ../.env --open --host 0.0.0.0 --port 3000",
    "start": "node .output/server/index.mjs",
    "start:generate": "npx serve .output/public",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "test": "vitest",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:run": "vitest run",
    "test:unit": "vitest run",
    "typecheck": "NODE_ENV=test nuxt typecheck --dotenv ../.env",
    "verify:analytics": "node scripts/verify-analytics-output.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.2",
    "nuxt-security": "2.7.0",
    "stripe": "23.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@iconify-json/carbon": "1.2.30",
    "@iconify-json/twemoji": "1.2.5",
    "@nuxt/devtools": "4.2.2",
    "@nuxt/eslint": "1.17.0",
    "@nuxtjs/color-mode": "4.1.0",
    "@pinia/nuxt": "1.0.3",
    "@playwright/test": "1.65.1",
    "@types/node": "^26.6.6",
    "@unocss/nuxt": "66.13.0",
    "@vitejs/devtools": "0.8.3",
    "@vitejs/devtools-kit": "0.8.3",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "2.6.0",
    "@vueuse/core": "15.1.0",
    "@vueuse/nuxt": "15.1.0",
    "h3": "2.0.8",
    "happy-dom": "^21.0.4",
    "nuxt": "4.7.0",
    "nuxt-explicit-imports": "0.1.0",
    "pinia": "4.1.0",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "unocss": "66.13.0",
    "vitest": "5.1.2",
    "vue": "3.5.46",
    "vue-router": "^5.5.1",
    "vue-tsc": "3.3.14"
  }
}

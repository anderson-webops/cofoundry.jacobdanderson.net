{
  "name": "front-end",
  "type": "module",
  "version": "1.1.107",
  "private": true,
  "description": "Nuxt frontend for CoFoundry",
  "author": "Jacob Anderson",
  "license": "ISC",
  "keywords": [],
  "scripts": {
    "build": "nuxt build --dotenv ../.env",
    "dev": "nuxt dev --dotenv ../.env --port 3000",
    "generate": "nuxt generate --dotenv ../.env",
    "prepare": "nuxt prepare",
    "preview": "nuxt preview --dotenv ../.env",
    "preview:e2e": "nuxt preview --host=127.0.0.1 --port=4173",
    "serve": "nuxt dev --dotenv ../.env --open --host 0.0.0.0 --port 3000",
    "start": "node .output/server/index.mjs",
    "start:generate": "npx serve .output/public",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "test": "vitest",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:run": "vitest run",
    "test:unit": "vitest run",
    "typecheck": "nuxt typecheck --dotenv ../.env",
    "verify:analytics": "node scripts/verify-analytics-output.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.111.0",
    "nuxt-security": "2.6.0",
    "stripe": "22.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@iconify-json/carbon": "1.2.25",
    "@iconify-json/twemoji": "1.2.5",
    "@nuxt/devtools": "3.4.0",
    "@nuxt/eslint": "1.16.0",
    "@nuxtjs/color-mode": "4.0.1",
    "@pinia/nuxt": "1.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "^24.13.3",
    "@unocss/nuxt": "66.7.5",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "2.4.11",
    "@vueuse/core": "14.4.0",
    "@vueuse/nuxt": "14.4.0",
    "h3": "1.15.11",
    "happy-dom": "^20.10.6",
    "nuxt": "4.5.1",
    "pinia": "4.0.2",
    "tsx": "4.23.1",
    "typescript": "^6.0.3",
    "unocss": "66.7.5",
    "vitest": "4.1.10",
    "vue": "3.5.40",
    "vue-router": "^5.1.0",
    "vue-tsc": "3.3.9"
  }
}

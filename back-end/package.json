{
	"name": "back-end",
	"version": "1.0.0",
	"description": "Operational backend workspace for CoFoundry",
	"type": "module",
	"engines": {
		"node": ">=22 <23"
	},
	"private": true,
	"main": "dist/server.js",
	"scripts": {
		"server": "tsx watch src/server.ts",
		"server:once": "tsx src/server.ts",
		"start": "node dist/server.js",
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "eslint \"src/**/*.{js,ts}\" \"scripts/**/*.ts\" \"test/**/*.ts\"",
		"lint-fix": "eslint \"src/**/*.{js,ts}\" \"scripts/**/*.ts\" \"test/**/*.ts\" --fix",
		"seed": "tsx scripts/seed.ts",
		"test": "node --test --import tsx test/**/*.test.ts",
		"test:run": "node --test --import tsx test/**/*.test.ts"
	},
	"dependencies": {
		"@supabase/supabase-js": "2.103.0",
		"dotenv": "17.4.1"
	},
	"devDependencies": {
		"@types/node": "25.6.0",
		"tsx": "4.21.0",
		"typescript": "6.0.2"
	}
}

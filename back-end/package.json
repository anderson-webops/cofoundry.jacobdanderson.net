{
  "name": "back-end",
  "version": "1.3.0",
  "description": "Operational backend workspace for CoFoundry",
  "type": "module",
  "private": true,
  "packageManager": "npm@12.2.1",
  "engines": {
    "node": ">=26.13.0 <27",
    "npm": ">=12.2.1 <13"
  },
  "main": "dist/server.js",
  "scripts": {
    "server": "node --env-file-if-exists=../.env --import tsx --watch src/server.ts",
    "server:once": "node --env-file-if-exists=../.env --import tsx src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.{js,ts}\" \"scripts/**/*.ts\" \"test/**/*.ts\"",
    "lint-fix": "eslint \"src/**/*.{js,ts}\" \"scripts/**/*.ts\" \"test/**/*.ts\" --fix",
    "bootstrap-admin": "node --import tsx scripts/bootstrap-admin.ts",
    "operations:alert-smoke": "node --import tsx scripts/operations-worker.ts alert-smoke",
    "operations:backup": "node --import tsx scripts/operations-worker.ts backup",
    "operations:digest": "node --import tsx scripts/operations-worker.ts digest",
    "operations:event": "node --import tsx scripts/operations-worker.ts event",
    "operations:heartbeat": "node --import tsx scripts/operations-worker.ts heartbeat",
    "operations:mail-smoke": "node --import tsx scripts/operations-worker.ts mail-smoke",
    "operations:realtime-smoke": "node --import tsx scripts/operations-worker.ts realtime-smoke",
    "operations:restore-drill": "node --import tsx scripts/operations-worker.ts restore-drill",
    "operations:scan": "node --import tsx scripts/operations-worker.ts scan",
    "operations:trust-verification": "node --import tsx scripts/operations-worker.ts trust-verification",
    "operations:worker": "node --import tsx scripts/operations-worker.ts",
    "seed": "node --env-file-if-exists=../.env --import tsx scripts/seed.ts",
    "test": "node --test --import tsx test/**/*.test.ts",
    "test:run": "node --test --import tsx test/**/*.test.ts",
    "verify:host-env": "node --import tsx scripts/verify-host-env.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "4.23.15",
    "typescript": "^7.0.2"
  }
}

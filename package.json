{
  "name": "cofoundry-monorepo",
  "type": "module",
  "version": "1.1.108",
  "private": true,
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.18.1 <25",
    "npm": ">=12.0.2 <13"
  },
  "description": "Monorepo for the CoFoundry founder matching platform",
  "author": "Jacob Anderson",
  "license": "ISC",
  "workspaces": [
    "front-end",
    "back-end"
  ],
  "overrides": {
    "glob": "13.0.6",
    "vite": {
      ".": "8.2.0",
      "esbuild": "0.28.1"
    },
    "brace-expansion": "$brace-expansion",
    "fast-uri": "3.1.4",
    "js-beautify": "$js-beautify",
    "js-yaml": "4.3.0",
    "postcss": "8.5.24",
    "shell-quote": "1.10.0",
    "svgo": "4.0.2",
    "tar": "7.5.22",
    "valibot": "1.4.2"
  },
  "scripts": {
    "audit": "npm audit --workspaces",
    "audit-fix": "npm audit fix --workspaces",
    "build": "npm run -w front-end build && npm run -w back-end build && npm run verify:build-secrets",
    "dev": "npm run -w front-end dev",
    "server": "npm run -w back-end server",
    "server:once": "npm run -w back-end server:once",
    "server:prompt:live-deploy": "node scripts/render-live-deploy-prompt.mjs",
    "serve": "npm run -w front-end serve",
    "preview": "npm run -w front-end preview",
    "generate": "npm run -w front-end generate",
    "lint-server": "npm run -w back-end lint-fix && npm run -w back-end server",
    "lint-serve": "npm run -w front-end lint-fix && npm run -w front-end serve",
    "lint": "npm run -w front-end lint && npm run -w back-end lint",
    "lint-fix": "npm run -w front-end lint-fix && npm run -w back-end lint-fix",
    "operations:alert-smoke": "npm run -w back-end operations:alert-smoke --",
    "operations:backup": "npm run -w back-end operations:backup --",
    "operations:digest": "npm run -w back-end operations:digest --",
    "operations:event": "npm run -w back-end operations:event --",
    "operations:heartbeat": "npm run -w back-end operations:heartbeat --",
    "operations:mail-smoke": "npm run -w back-end operations:mail-smoke --",
    "operations:realtime-smoke": "npm run -w back-end operations:realtime-smoke --",
    "operations:restore-drill": "npm run -w back-end operations:restore-drill --",
    "operations:scan": "npm run -w back-end operations:scan --",
    "operations:trust-verification": "npm run -w back-end operations:trust-verification --",
    "operations:worker": "npm run -w back-end operations:worker --",
    "typecheck": "npm run -w front-end typecheck && npm run -w back-end typecheck",
    "seed": "npm run -w back-end seed",
    "test": "npm run -w front-end test",
    "test:unit": "npm run -w front-end test:unit && npm run -w back-end test:run",
    "test:e2e": "npm run -w front-end test:e2e",
    "test:run": "npm run test:unit",
    "verify:analytics": "npm run -w front-end verify:analytics",
    "verify:build-secrets": "node scripts/verify-build-secret-boundary.mjs",
    "verify:deployment-identity": "node scripts/verify-deployment-identity-fallback.mjs",
    "verify:github-actions": "node scripts/verify-github-actions-health.mjs",
    "verify:host-env": "npm run -w back-end verify:host-env --",
    "verify:install-scripts": "node scripts/verify-install-script-policy.mjs",
    "verify:public": "node scripts/verify-public-site.mjs",
    "verify:public:dispatch": "node scripts/dispatch-public-verification.mjs",
    "verify:public:local": "node scripts/verify-public-local.mjs",
    "verify:release:local": "node scripts/verify-local-release.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "verify:shared-shims": "node scripts/verify-shared-shims.mjs",
    "verify:standalone-installs": "node scripts/verify-standalone-workspace-installs.mjs",
    "verify:toolchain": "node scripts/verify-toolchain-policy.mjs",
    "clean": "rm -rf node_modules package-lock.json front-end/node_modules front-end/.nuxt front-end/.output front-end/3000 front-end/dist back-end/node_modules back-end/dist .nuxt .output .data",
    "postinstall": "npm run -w front-end prepare",
    "a11y": "node scripts/a11y-smoke.mjs",
    "a11y:production": "A11Y_USE_BUILT_SERVER=true A11Y_FRONTEND_PORT=3345 node scripts/a11y-smoke.mjs"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@unocss/eslint-plugin": "66.7.5",
    "axe-core": "^4.12.1",
    "brace-expansion": "5.0.9",
    "eslint": "10.8.0",
    "eslint-plugin-format": "2.0.1",
    "globals": "^17.7.0",
    "js-beautify": "2.0.3",
    "puppeteer": "^25.4.0",
    "typescript": "^6.0.3",
    "vue": "3.5.40"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "puppeteer@24.43.1": true,
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher@2.5.6": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true
  }
}

{
  "name": "cofoundry-monorepo",
  "type": "module",
  "version": "1.3.3",
  "private": true,
  "packageManager": "npm@12.2.2",
  "engines": {
    "node": ">=26.13.1 <27",
    "npm": ">=12.2.2 <13"
  },
  "description": "Monorepo for the CoFoundry founder matching platform",
  "author": "Jacob Anderson",
  "license": "ISC",
  "workspaces": [
    "front-end",
    "back-end"
  ],
  "overrides": {
    "picomatch": "$picomatch",
    "unimport": "$unimport",
    "nuxt-explicit-imports": "$nuxt-explicit-imports",
    "@vitejs/devtools@^0.8.0": "0.8.3",
    "@vitejs/devtools-kit@^0.8.0": "0.8.3",
    "braces": "$braces",
    "deepmerge": "$deepmerge",
    "listhen": "$listhen",
    "glob": "14.0.6",
    "minimatch": "11.0.9",
    "brace-expansion": "$brace-expansion",
    "js-beautify": "$js-beautify",
    "tinypool": "2.2.0",
    "katex": "0.19.1"
  },
  "scripts": {
    "audit": "node scripts/run-pinned-npm.mjs audit --workspaces --include-workspace-root --include=dev --audit-level=low",
    "audit:production": "node scripts/run-pinned-npm.mjs audit --workspaces --include-workspace-root --omit=dev --audit-level=low",
    "audit-fix": "node scripts/run-pinned-npm.mjs audit fix --workspaces",
    "build": "node scripts/run-pinned-npm.mjs run -w front-end build && node scripts/run-pinned-npm.mjs run -w back-end build && node scripts/verify-build-secret-boundary.mjs",
    "dev": "node scripts/run-pinned-npm.mjs run -w front-end dev",
    "server": "node scripts/run-pinned-npm.mjs run -w back-end server",
    "server:once": "node scripts/run-pinned-npm.mjs run -w back-end server:once",
    "serve": "node scripts/run-pinned-npm.mjs run -w front-end serve",
    "preview": "node scripts/run-pinned-npm.mjs run -w front-end preview",
    "generate": "node scripts/run-pinned-npm.mjs run -w front-end generate",
    "lint-server": "node scripts/run-pinned-npm.mjs run -w back-end lint-fix && node scripts/run-pinned-npm.mjs run -w back-end server",
    "lint-serve": "node scripts/run-pinned-npm.mjs run -w front-end lint-fix && node scripts/run-pinned-npm.mjs run -w front-end serve",
    "lint": "node scripts/run-pinned-npm.mjs run -w front-end lint && node scripts/run-pinned-npm.mjs run -w back-end lint",
    "lint-fix": "node scripts/run-pinned-npm.mjs run -w front-end lint-fix && node scripts/run-pinned-npm.mjs run -w back-end lint-fix",
    "operations:alert-smoke": "node scripts/run-pinned-npm.mjs run -w back-end operations:alert-smoke --",
    "operations:backup": "node scripts/run-pinned-npm.mjs run -w back-end operations:backup --",
    "operations:digest": "node scripts/run-pinned-npm.mjs run -w back-end operations:digest --",
    "operations:event": "node scripts/run-pinned-npm.mjs run -w back-end operations:event --",
    "operations:heartbeat": "node scripts/run-pinned-npm.mjs run -w back-end operations:heartbeat --",
    "operations:mail-smoke": "node scripts/run-pinned-npm.mjs run -w back-end operations:mail-smoke --",
    "operations:realtime-smoke": "node scripts/run-pinned-npm.mjs run -w back-end operations:realtime-smoke --",
    "operations:restore-drill": "node scripts/run-pinned-npm.mjs run -w back-end operations:restore-drill --",
    "operations:scan": "node scripts/run-pinned-npm.mjs run -w back-end operations:scan --",
    "operations:trust-verification": "node scripts/run-pinned-npm.mjs run -w back-end operations:trust-verification --",
    "operations:worker": "node scripts/run-pinned-npm.mjs run -w back-end operations:worker --",
    "package:runtime": "bash scripts/package-runtime.sh",
    "typecheck": "node scripts/run-pinned-npm.mjs run -w front-end typecheck && node scripts/run-pinned-npm.mjs run -w back-end typecheck",
    "seed": "node scripts/run-pinned-npm.mjs run -w back-end seed",
    "test": "node scripts/run-pinned-npm.mjs run -w front-end test",
    "test:unit": "node scripts/run-pinned-npm.mjs run -w front-end test:unit && node scripts/run-pinned-npm.mjs run -w back-end test:run && node --test scripts/test-braces-compat.mjs scripts/test-deepmerge-compat.mjs scripts/test-listhen-compat.mjs scripts/test-build-secret-boundary.mjs scripts/test-transitive-compat.mjs && node scripts/run-pinned-npm.mjs run test:devtools",
    "test:devtools": "node --test scripts/test-devtools-provider.mjs scripts/test-vue-devtools-compat.mjs && node scripts/test-vue-devtools-host.mjs",
    "test:e2e": "node scripts/run-pinned-npm.mjs run -w front-end test:e2e",
    "test:run": "node scripts/run-pinned-npm.mjs run test:unit",
    "test:runtime-artifact": "python3 -B -m unittest scripts/test_runtime_artifact.py scripts/test_trusted_paths.py scripts/test_host_control_bundle.py scripts/test_native_service_profile.py scripts/test_maintained_providers.py && node --test scripts/native-artifact-transport.test.mjs",
    "test:promotion-recovery": "bash scripts/test-promotion-recovery.sh",
    "verify:analytics": "node scripts/run-pinned-npm.mjs run -w front-end verify:analytics",
    "verify:build-secrets": "node scripts/verify-build-secret-boundary.mjs",
    "verify:build-toolchain": "node scripts/check-build-toolchain.mjs",
    "verify:deployment-identity": "node scripts/verify-deployment-identity-fallback.mjs",
    "verify:github-actions": "node scripts/verify-github-actions-health.mjs",
    "verify:host-env": "node scripts/run-pinned-npm.mjs run -w back-end verify:host-env --",
    "verify:install-scripts": "node scripts/verify-install-script-policy.mjs",
    "verify:explicit-imports": "node node_modules/nuxt-explicit-imports/dist/cli.mjs check --root front-end",
    "verify:maintained-providers": "python3 -B scripts/package-site-deepmerge.py --check && python3 -B scripts/package-picomatch.py --check && python3 -B scripts/check-unimport-source.py && python3 -B scripts/verify-maintained-providers.py",
    "verify:public": "node scripts/verify-public-site.mjs",
    "verify:public:dispatch": "node scripts/dispatch-public-verification.mjs",
    "verify:public:local": "node scripts/verify-public-local.mjs",
    "verify:release:local": "node scripts/verify-local-release.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "verify:shared-shims": "node scripts/verify-shared-shims.mjs",
    "verify:standalone-installs": "node scripts/verify-standalone-workspace-installs.mjs",
    "verify:toolchain": "node scripts/verify-toolchain-policy.mjs",
    "clean": "rm -rf node_modules package-lock.json front-end/node_modules front-end/.nuxt front-end/.output front-end/3000 front-end/dist back-end/node_modules back-end/dist .nuxt .output .data",
    "postinstall": "node scripts/run-pinned-npm.mjs run -w front-end prepare",
    "a11y": "node scripts/a11y-smoke.mjs",
    "a11y:production": "A11Y_USE_BUILT_SERVER=true A11Y_FRONTEND_PORT=3345 node scripts/a11y-smoke.mjs"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@unocss/eslint-plugin": "66.13.0",
    "@vitejs/devtools-kit": "0.8.3",
    "axe-core": "^4.14.1",
    "brace-expansion": "5.0.13",
    "braces": "file:vendor/braces-3.0.4-webops.3.tgz",
    "deepmerge": "file:vendor/deepmerge-4.3.2-cofoundry.1.tgz",
    "eslint": "10.15.0",
    "eslint-plugin-format": "2.0.1",
    "eslint-plugin-slop": "^0.1.3",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.14.0",
    "happy-dom": "21.0.4",
    "js-beautify": "2.0.3",
    "listhen": "file:vendor/listhen-1.10.1-webops.3.tgz",
    "nuxt-explicit-imports": "file:vendor/nuxt-explicit-imports-0.1.0-webops.2.tgz",
    "oxc-parser": "0.159.0",
    "picomatch": "file:vendor/picomatch-4.0.7-webops.1.tgz",
    "puppeteer": "25.19.0",
    "typescript": "^6.0.3",
    "unimport": "file:vendor/unimport-7.0.3-webops.2.tgz",
    "vite-plugin-vue-devtools": "9.0.0-rc.3",
    "vue": "3.5.46"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "puppeteer@25.19.0": true,
    "fsevents@2.3.3": true
  }
}
